# web/.env.example — copy to web/.env.local (gitignored) and fill in.
# MODE3_SPEC §0.2: exactly one file in web/ may hold a model secret and may call a model at
# request time (app/api/ask/route.ts, through lib/ask/anthropic.ts). Everything else is a
# Server Component reading precomputed rows over DATABASE_URL.

# role f1 — the app's and ingest's own pool, every page and every lib/queries/*.  (unchanged)
# Production (OPS_SPEC §6.2): role f1_web (SELECT-only, scripts/sql/0011_web_role.sql) on the
# POOLED endpoint, never the owner:
#   postgres://f1_web:...@<ep>-pooler.<region>.aws.neon.tech/f1?sslmode=verify-full
# `sslmode=verify-full` in every Vercel DSN: pg 8.23 treats `require` as a deprecated alias
# and prints a security warning on every cold start.
DATABASE_URL=postgres://f1:f1@localhost:5432/f1

# role f1_ask — generated SQL only, used by lib/ask/execute.ts through lib/ask/askPool.ts.
# No grant at all in schema public; SELECT on the 57 views of schema `ask`. NO FALLBACK: if
# this is unset the ask box refuses to serve rather than quietly running as f1.
#   scripts/db_ask_verify.sh is the gate: 32/32 on Neon BEFORE this is ever set in Vercel.
# Production: the DIRECT endpoint (no -pooler) — lib/ask/execute.ts uses a named prepared
# statement and askPool.ts cancels by pg_backend_pid() from a second connection, which is
# session state a transaction pooler cannot promise:
#   postgres://f1_ask:...@<ep>.<region>.aws.neon.tech/f1?sslmode=verify-full
ASK_DATABASE_URL=

# role f1_ask_log — the query log only, used by lib/ask/log.ts and the §5.3 limit checks.
# INSERT on ask_query_log; SELECT on four of its columns; it cannot read a question back.
# Production: the POOLED endpoint; its role-level GUCs apply at server-connection start and
# survive transaction pooling:
#   postgres://f1_ask_log:...@<ep>-pooler.<region>.aws.neon.tech/f1?sslmode=verify-full
ASK_LOG_DATABASE_URL=

# Read by lib/ask/anthropic.ts and by nothing else. Never committed, never logged.
# An ingest without a key must still succeed (§4.6), and the ask box simply turns itself off.
# Production: unset at launch (OPS_SPEC F7). Set last, only after db_ask_verify.sh passes on
# Neon, ASK_DAILY_BUDGET_USD is 2.00 and the console spend limit exists. Never in Preview.
ANTHROPIC_API_KEY=

# §5.3 — the global daily tripwire, in USD. Over budget, the ask box turns itself off until
# UTC midnight. It is a tripwire, not a dial: hitting it twice in a week means the other caps
# are wrong, not that the budget should be raised. Default 5.00 when unset.
# Production: 2.00 (OPS_SPEC D15), set BEFORE any key exists — a $62/month ceiling.
ASK_DAILY_BUDGET_USD=5.00

# §5.3 — salt for sha256(ip + salt) in the per-IP token bucket. The raw IP is never stored or
# logged. Any long random string; changing it resets the buckets.
# Production: `openssl rand -base64 32`, never the local value.
ASK_IP_SALT=

# REVALIDATE_SPEC §2 — bearer secret for POST /api/revalidate, the nightly push's cache hook.
# Production only, at least 32 characters: `openssl rand -hex 32`, entered with
# `vercel env add REVALIDATE_SECRET production < file`, never on a command line, never in
# Preview. Unset locally (or shorter than 32 chars) = the route is off and answers 503.
REVALIDATE_SECRET=

# Every production value is scoped Production only (Preview gets nothing) and entered with
# `vercel env add NAME production < file`, never on a command line. Never in Vercel at all:
# the owner DSN, REMOTE_DATABASE_URL (role f1_push; lives in ~/.config/f1analytics/remote.env),
# anything from this file's local copy.
